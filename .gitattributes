frontend/piano_transcription/piano_transcription_inference_data/*.pth filter=lfs diff=lfs merge=lfs -text

# ---- cross-platform line endings (overrides core.autocrlf) ----
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.musicxml text eol=lf
*.tex text eol=lf
*.sh text eol=lf
*.sha256 text eol=lf
*.log text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
# ---- coverage-gap fix 2026-10-03 (main control): these were in NEITHER list, so a Windows
# ---- checkout with core.autocrlf=true rewrote them as CRLF and broke the raw-byte digests.
*.ipynb text eol=lf
*.aux text eol=lf
*.out text eol=lf
*.mpos text eol=lf
*.invalid_v2_perfdomain text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.rst text eol=lf
*.html text eol=lf
*.css text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# ---- binary markers (prevent git mis-conversion) ----
*.mid binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pkl binary
*.joblib binary
*.wav binary
*.mp3 binary
*.zip binary
*.gz binary
*.svg binary
